<?xml version="1.0" encoding="utf-8"?>
<!-- The user's own CAs are trusted too: a home server's CA is usually one the user installed. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
